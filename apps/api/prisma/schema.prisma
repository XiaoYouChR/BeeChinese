generator client { provider = "prisma-client-js" }

datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model User { id String @id @default(cuid()) email String @unique status String @default("active") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("users") }
model UserProfile { id String @id @default(cuid()) userId String @unique @map("user_id") displayName String? @map("display_name") avatarUrl String? @map("avatar_url") nativeLang String? @map("native_lang") targetLang String? @map("target_lang") status String @default("active") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("user_profiles") @@index([userId]) }
model Role { id String @id @default(cuid()) code String @unique name String status String @default("active") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("roles") }
model UserRole { id String @id @default(cuid()) userId String @map("user_id") roleId String @map("role_id") status String @default("active") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@unique([userId, roleId]) @@map("user_roles") @@index([userId]) @@index([roleId]) }
model EmailVerificationCode { id String @id @default(cuid()) email String code String expiresAt DateTime @map("expires_at") usedAt DateTime? @map("used_at") status String @default("valid") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("email_verification_codes") @@index([email, code]) }
model Teacher { id String @id @default(cuid()) userId String @map("user_id") bio String? status String @default("active") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("teachers") @@index([userId]) }
model Course { id String @id @default(cuid()) teacherId String? @map("teacher_id") title String description String? coverUrl String? @map("cover_url") level String? status String @default("draft") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("courses") @@index([teacherId, status]) }
model CourseChapter { id String @id @default(cuid()) courseId String @map("course_id") title String sortOrder Int @default(0) @map("sort_order") status String @default("active") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("course_chapters") @@index([courseId, sortOrder]) }
model CourseLesson { id String @id @default(cuid()) chapterId String @map("chapter_id") title String content String? videoUrl String? @map("video_url") durationSec Int? @map("duration_sec") sortOrder Int @default(0) @map("sort_order") status String @default("active") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("course_lessons") @@index([chapterId, sortOrder]) }
model Enrollment { id String @id @default(cuid()) userId String @map("user_id") courseId String @map("course_id") progressPercent Int @default(0) @map("progress_percent") status String @default("active") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("enrollments") @@unique([userId, courseId]) }
model LessonProgress { id String @id @default(cuid()) userId String @map("user_id") lessonId String @map("lesson_id") progressPercent Int @default(0) @map("progress_percent") watchSeconds Int @default(0) @map("watch_seconds") status String @default("active") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("lesson_progress") @@unique([userId, lessonId]) }
model LessonComment { id String @id @default(cuid()) lessonId String @map("lesson_id") userId String @map("user_id") content String status String @default("published") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("lesson_comments") @@index([lessonId]) }
model Exercise { id String @id @default(cuid()) lessonId String? @map("lesson_id") title String description String? status String @default("active") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("exercises") @@index([lessonId]) }
model ExerciseQuestion { id String @id @default(cuid()) exerciseId String @map("exercise_id") questionType String @map("question_type") stem String standardAnswer String? @map("standard_answer") sortOrder Int @default(0) @map("sort_order") status String @default("active") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("exercise_questions") @@index([exerciseId, sortOrder]) }
model ExerciseSubmission { id String @id @default(cuid()) exerciseId String @map("exercise_id") userId String @map("user_id") score Float? status String @default("submitted") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("exercise_submissions") @@index([exerciseId, userId]) }
model ExerciseSubmissionAnswer { id String @id @default(cuid()) submissionId String @map("submission_id") questionId String @map("question_id") answerText String? @map("answer_text") isCorrect Boolean? @map("is_correct") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("exercise_submission_answers") @@index([submissionId]) }
model AiFeedbackRecord { id String @id @default(cuid()) submissionId String? @map("submission_id") feedbackType String @map("feedback_type") provider String result Json status String @default("success") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("ai_feedback_records") @@index([submissionId]) }
model SpeakingSentence { id String @id @default(cuid()) text String pinyin String? translation String? difficulty String? status String @default("active") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("speaking_sentences") }
model SpeakingPracticeRecord { id String @id @default(cuid()) userId String @map("user_id") sentenceId String @map("sentence_id") audioUrl String? @map("audio_url") overallScore Float? @map("overall_score") status String @default("done") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("speaking_practice_records") @@index([userId, sentenceId]) }
model SpeakingErrorItem { id String @id @default(cuid()) practiceRecordId String @map("practice_record_id") word String? issueType String? @map("issue_type") suggestion String? status String @default("active") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("speaking_error_items") @@index([practiceRecordId]) }
model UserFavoriteSentence { id String @id @default(cuid()) userId String @map("user_id") sentenceId String @map("sentence_id") status String @default("active") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("user_favorite_sentences") @@unique([userId, sentenceId]) }
model AiScenario { id String @id @default(cuid()) code String @unique title String promptTemplate String? @map("prompt_template") status String @default("active") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("ai_scenarios") }
model AiSession { id String @id @default(cuid()) userId String @map("user_id") scenarioId String @map("scenario_id") status String @default("active") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("ai_sessions") @@index([userId, scenarioId]) }
model AiSessionMessage { id String @id @default(cuid()) sessionId String @map("session_id") role String content String audioUrl String? @map("audio_url") status String @default("active") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("ai_session_messages") @@index([sessionId]) }
model AiSessionReport { id String @id @default(cuid()) sessionId String @map("session_id") score Float? report Json? status String @default("ready") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("ai_session_reports") @@unique([sessionId]) }
model ForumPost { id String @id @default(cuid()) userId String @map("user_id") title String content String tags Json? status String @default("published") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("forum_posts") @@index([status, createdAt]) }
model ForumComment { id String @id @default(cuid()) postId String @map("post_id") userId String @map("user_id") content String status String @default("published") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("forum_comments") @@index([postId]) }
model ExpertAiReply { id String @id @default(cuid()) postId String @map("post_id") tag String content Json provider String @default("mock") status String @default("generated") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("expert_ai_replies") @@index([postId]) }
model Order { id String @id @default(cuid()) userId String @map("user_id") orderNo String @unique @map("order_no") amount Decimal @db.Decimal(10,2) currency String @default("CNY") status String @default("pending") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("orders") @@index([userId, status]) }
model Payment { id String @id @default(cuid()) orderId String @map("order_id") channel String @default("wechat") transactionNo String? @map("transaction_no") amount Decimal @db.Decimal(10,2) status String @default("pending") paidAt DateTime? @map("paid_at") metadata Json? ext Json? createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@map("payments") @@index([orderId, status]) }
